' Shared look for every Tulsi Tiffins diagram (Tulsi green + saffron).
skinparam dpi 200
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 6
skinparam ArrowColor #2d6a41
skinparam ArrowFontSize 10
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 13
skinparam TitleFontStyle bold
skinparam LegendBackgroundColor #FAF9F5
skinparam LegendBorderColor #B9D8C3
skinparam LegendFontSize 10
skinparam NoteBackgroundColor #FCEFDC
skinparam NoteBorderColor #D98A1F
skinparam ActorBorderColor #2d6a41
skinparam ActorBackgroundColor #E7F2EA
skinparam UsecaseBorderColor #2d6a41
skinparam UsecaseBackgroundColor #E7F2EA
skinparam ComponentBorderColor #2d6a41
skinparam ComponentBackgroundColor #E7F2EA
skinparam InterfaceBorderColor #2d6a41
skinparam InterfaceBackgroundColor #FFFFFF
skinparam PackageBorderColor #5D645F
skinparam PackageBackgroundColor #FFFFFF
skinparam NodeBorderColor #2d6a41
skinparam NodeBackgroundColor #FAF9F5
skinparam DatabaseBorderColor #9A5A00
skinparam DatabaseBackgroundColor #FCEFDC
skinparam ArtifactBorderColor #5D645F
skinparam ArtifactBackgroundColor #FFFFFF
skinparam RectangleBorderColor #5D645F
skinparam ClassBorderColor #2d6a41
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #E7F2EA
skinparam ClassAttributeFontSize 10
skinparam EnumBackgroundColor #FCEFDC
skinparam SequenceLifeLineBorderColor #8A948D
skinparam SequenceParticipantBorderColor #2d6a41
skinparam SequenceParticipantBackgroundColor #E7F2EA
skinparam SequenceGroupBorderColor #D98A1F
skinparam SequenceGroupHeaderFontColor #9A5A00
skinparam SequenceBoxBorderColor #B9D8C3
