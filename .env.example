# Tulsi Tiffins POS — environment
# Copy to .env and adjust. docker compose reads .env from the repo root automatically.
# Every value below also has a safe default baked into docker-compose.yml, so
# `docker compose up` works on a clean machine even without this file.

# --- database ---
POSTGRES_USER=tulsi
POSTGRES_PASSWORD=tulsi
POSTGRES_DB=tulsi_pos
# Used by the api service. Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg2://tulsi:tulsi@db:5432/tulsi_pos

# --- auth ---
# CHANGE THIS before any real deployment.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_HOURS=8

# --- business config ---
UPI_ID=tulsitiffins@upi
UPI_PAYEE_NAME=Tulsi Tiffins
GST_RATE=0.05

# --- ports on the host ---
WEB_PORT=5173
API_PORT=8000
DB_PORT=5432
